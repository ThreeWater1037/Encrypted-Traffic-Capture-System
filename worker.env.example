# Worker Flask 自身标识与监听地址
WORKER_ID=win-01
WORKER_HOST=0.0.0.0
WORKER_PORT=5100
WORKER_TOKEN=replace-with-a-long-random-token

# 项目和实际采集解释器。不同机器使用各自的绝对路径。
PROJECT_ROOT=D:\Project\Encrypted Traffic Capture System
PYTHON_EXECUTABLE=D:\Anaconda\envs\encrypted-traffic\python.exe

# 原始 PCAP、日志和分析结果只保存在这个本地目录。
WORKER_DATA_DIR=D:\TrafficCaptureWorker\data
MAX_QUEUE_SIZE=10
MAX_ITEMS=10000
TASK_TIMEOUT_SECONDS=21600
MAX_CONTENT_LENGTH=20971520
WORKER_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
