# 主控默认只监听本机；迁移后如需局域网访问再改为 0.0.0.0。
MASTER_HOST=127.0.0.1
MASTER_PORT=5200
MASTER_TOKEN=
MASTER_DATA_DIR=D:\TrafficCaptureMaster\data
MASTER_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 主控启动时自动注册的本机 Worker。
LOCAL_WORKER_ID=worker-local
LOCAL_WORKER_NAME=本机 Worker
LOCAL_WORKER_URL=http://127.0.0.1:5100
LOCAL_WORKER_TOKEN=dev-worker-token

WORKER_REQUEST_TIMEOUT=15
MASTER_POLL_INTERVAL=2
MASTER_MAX_QUEUE_SIZE=100
MASTER_MAX_ITEMS=10000
MASTER_MAX_CONTENT_LENGTH=20971520
